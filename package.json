{
  "readme": "https://github.com/hisptz/action-tracker-standalone/blob/develop/README.md",
  "name": "action-tracker-standalone",
  "version": "2.0.2-beta.01",
  "description": "The action tracker is a management tool that helps improve effective coverage of priority interventions at district and community level, covering various interventions such as maternal, newborn, and child health (MNCH), HIV, and nutrition. ",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "build": "d2-app-scripts build --no-verify",
    "start": "dotenv -- cross-var d2-app-scripts start --proxy %DHIS2_PROXY%",
    "test": "d2-app-scripts test",
    "e2e": "concurrently 'pnpm cy:start' 'wait-on 'http-get://localhost:3000' && cypress run' --kill-others --success first",
    "e2e:interactive": "npx cypress open",
    "deploy": "d2-app-scripts deploy",
    "cy:start": "REACT_APP_NODE_ENV=test BROWSER=none pnpm start",
    "cy:prepare": "start-server-and-test 'pnpm cy:start' http://localhost:3000",
    "test:open": "pnpm cy:prepare 'pnpm cypress open --env networkMode=live'",
    "_cy:live": "dotenv -- cross-var pnpm cypress run --env networkMode=live --key %CYPRESS_RECORD_KEY%",
    "test:live": "pnpm cy:prepare 'pnpm _cy:live'",
    "_cy:capture": "pnpm cypress run --env networkMode=capture",
    "test:capture": "pnpm cy:prepare 'pnpm _cy:capture'",
    "_cy:stub": "dotenv -- cross-var pnpm cypress run --env networkMode=stub --record --key %CYPRESS_RECORD_KEY%",
    "test:stub": "pnpm cy:prepare 'pnpm _cy:stub'",
    "clean": "rm -rf .d2 build node_modules",
    "ybd": "pnpm build && dotenv -- cross-var pnpm run deploy --username %D2_USERNAME% %DHIS2_PROXY%"
  },
  "author": {
    "email": "dev@hisptanzania.org",
    "name": "HISP Tanzania",
    "url": "https://hisptanzania.org"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "16.0.3",
    "@cypress/react": "^7.0.3",
    "@cypress/webpack-preprocessor": "^5.17.1",
    "@dhis2/cli-app-scripts": "^12.8.0-alpha.1",
    "@dhis2/cli-utils-cypress": "^10.1.0",
    "@dhis2/cypress-commands": "^10.1.0",
    "@dhis2/cypress-plugins": "^10.1.0",
    "@hookform/devtools": "^4.4.0",
    "@types/async": "^3.2.20",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.3",
    "@types/lodash": "^4.14.196",
    "@types/luxon": "^3.3.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "concurrently": "^8.2.0",
    "cross-var": "^1.1.0",
    "cucumber": "^7.0.0-rc.0",
    "cypress": "^12.17.3",
    "cypress-multi-reporters": "^1.6.3",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.56.0",
    "eslint-config-standard-with-typescript": "^37.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.33.0",
    "prettier": "^3.2.4",
    "semantic-release": "^25.0.1",
    "start-server-and-test": "^2.0.0",
    "typescript": "5.1.6",
    "vite": "^7.1.7",
    "vite-plugin-svgr": "^4.5.0",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@dhis2/app-runtime": "^3.14.5",
    "@dhis2/app-service-datastore": "^1.0.0-alpha.2",
    "@dhis2/d2-i18n": "^1.1.3",
    "@dhis2/multi-calendar-dates": "^2.1.2",
    "@dhis2/ui": "^10.8.1",
    "@hisptz/dhis2-ui": "^2.0.48",
    "@hisptz/dhis2-utils": "^2.0.18",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.90.1",
    "@tanstack/react-table": "^8.21.3",
    "async": "^3.2.4",
    "async-es": "^3.2.6",
    "classnames": "^2.3.2",
    "file-saver": "^2.0.5",
    "intro.js": "^7.2.0",
    "intro.js-react": "0.7.1",
    "lodash": "^4.17.21",
    "luxon": "^3.3.0",
    "react": "^18.3.1",
    "react-collapsible": "^2.10.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.11",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "^7.7.0",
    "react-to-print": "^2.14.15",
    "recoil": "^0.7.7",
    "usehooks-ts": "^2.9.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "stepDefinitions": [
      "cypress/e2e/[filepath]/**/*.{js,ts}",
      "cypress/e2e/[filepath].{js,ts}",
      "cypress/e2e/common/**/*.{js,ts}"
    ]
  },
  "packageManager": "pnpm@10.17.0"
}
